<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PinView Custom Attributes -->
    <declare-styleable name="PinView">

        <!-- PIN Configuration -->
        <attr name="pinLength" format="integer" />
        <attr name="pinViewType" format="enum">
            <enum name="box" value="0" />
            <enum name="circle" value="1" />
            <enum name="underline" value="2" />
        </attr>

        <!-- Box Dimensions -->
        <attr name="boxWidth" format="dimension" />
        <attr name="boxHeight" format="dimension" />
        <attr name="boxSpacing" format="dimension" />
        <attr name="cornerRadius" format="dimension" />

        <!-- Border Styling -->
        <attr name="borderWidth" format="dimension" />
        <attr name="normalBorderColor" format="color" />
        <attr name="focusedBorderColor" format="color" />
        <attr name="errorBorderColor" format="color" />
        <attr name="filledBorderColor" format="color" />

        <!-- Background & Text -->
        <attr name="boxBackgroundColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="fontFamily" format="string" />

        <!-- Cursor -->
        <attr name="cursorColor" format="color" />
        <attr name="cursorWidth" format="dimension" />
        <attr name="cursorHeight" format="dimension" />
        <attr name="cursorVisible" format="boolean" />

        <!-- Masking -->
        <attr name="maskEnabled" format="boolean" />
        <attr name="maskCharacter" format="string" />
        <attr name="maskDelay" format="integer" />

        <!-- Animation -->
        <attr name="animationEnabled" format="boolean" />
        <attr name="errorShakeEnabled" format="boolean" />
        <attr name="scaleAnimationEnabled" format="boolean" />

        <!-- Behavior -->
        <attr name="clearOnError" format="boolean" />
        <attr name="autoSubmit" format="boolean" />
        <attr name="secureInput" format="boolean" />

        <!-- State Colors -->
        <attr name="disabledAlpha" format="float" />
        <attr name="filledTextColor" format="color" />

    </declare-styleable>
</resources>